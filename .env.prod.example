# Fichier d'environnement de PRODUCTION (à copier en .env.prod, ne jamais publier)
APP_URL=https://www.votre-domaine.sn
APP_KEY=base64:REMPLACEZ_PAR_UNE_CLE_GENEREE
HTTP_PORT=80

DB_DATABASE=teranga
DB_USERNAME=teranga
DB_PASSWORD=un-mot-de-passe-long-et-unique
DB_ROOT_PASSWORD=un-autre-mot-de-passe-long

MAIL_MAILER=smtp
MAIL_HOST=smtp.votre-fournisseur.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=reservations@votre-domaine.sn

AGENCY_NAME="Teranga Voyages"
AGENCY_EMAIL=contact@votre-domaine.sn
AGENCY_PHONE="+221 33 000 00 00"

# true = remplit la base avec des données de démonstration au premier lancement
SEED_DEMO=false

# simulation = paiements fictifs (démo) | live = Wave réel si WAVE_API_KEY est renseigné
PAYMENT_DEFAULT_DRIVER=simulation
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
