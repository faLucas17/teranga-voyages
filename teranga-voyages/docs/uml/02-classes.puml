@startuml classes
!include _style.iuml
title Diagramme de classes — modèle métier
hide empty methods

enum Role {
  admin
  agent
  client
}

enum StatutReservation {
  pending
  confirmed
  paid
  cancelled
  completed
}

enum StatutPaiement {
  pending
  succeeded
  failed
  refunded
}

class User {
  +id : int
  +name : string
  +email : string
  +phone : string
  +role : Role
  +is_active : bool
  +password : string
  --
  +isAdmin() : bool
  +isStaff() : bool
}

class Destination {
  +id : int
  +name : string
  +slug : string
  +country : string
  +continent : string
  +image : string
  +is_featured : bool
}

class TravelPackage <<Voyage>> {
  +id : int
  +title : string
  +type : string
  +duration_days : int
  +start_date : date
  +end_date : date
  +price : int
  +child_price : int
  +seats_total : int
  +seats_available : int
  +itinerary : json
  +included : json
  +is_featured : bool
  --
  +effectiveChildPrice() : int
}

class Hotel {
  +id : int
  +name : string
  +stars : int
  +price_per_night : int
  +rooms_available : int
  +amenities : json
}

class Flight <<Vol>> {
  +id : int
  +airline : string
  +flight_number : string
  +from_code : string
  +to_code : string
  +departure_at : datetime
  +arrival_at : datetime
  +cabin_class : string
  +price : int
  +seats_available : int
}

interface Reservable <<bookable>>

class Booking <<Réservation>> {
  +id : int
  +reference : string
  +start_date : date
  +adults : int
  +children : int
  +subtotal : int
  +discount : int
  +total : int
  +status : StatutReservation
  +meta : json
  --
  +amount_paid() : int
  +balance_due() : int
  +isPayable() : bool
  +cancel(reason) : void
}

class Traveler <<Voyageur>> {
  +first_name : string
  +last_name : string
  +type : adult|child
  +birth_date : date
  +passport_number : string
}

class Payment <<Paiement>> {
  +amount : int
  +method : string
  +driver : string
  +status : StatutPaiement
  +transaction_ref : string
  +paid_at : datetime
}

class Coupon <<Code promo>> {
  +code : string
  +type : percent|fixed
  +value : int
  +max_uses : int
  +used_count : int
  +expires_at : datetime
  --
  +validationError(amount) : ?string
  +discountFor(amount) : int
}

class Review <<Avis>> {
  +rating : 1..5
  +comment : text
  +is_approved : bool
}

class VisaRequest <<Demande de visa>> {
  +reference : string
  +destination_country : string
  +visa_type : string
  +status : string
}

class ContactMessage
class NewsletterSubscriber
class Setting {
  +key : string
  +value : text
  +is_public : bool
}

TravelPackage ..|> Reservable
Hotel ..|> Reservable
Flight ..|> Reservable

Destination "1" -- "0..*" TravelPackage : propose >
Destination "1" -- "0..*" Hotel : compte >
User "1" -- "0..*" Booking : effectue >
Booking "0..*" -- "1" Reservable : concerne >
Booking "1" *-- "0..*" Traveler : contient >
Booking "1" *-- "0..*" Payment : est réglée par >
Booking "0..*" -- "0..1" Coupon : utilise >
User "1" -- "0..*" Review : rédige >
TravelPackage "1" -- "0..*" Review : reçoit >
User "0..*" -- "0..*" TravelPackage : favoris >
User "0..1" -- "0..*" VisaRequest : dépose >
User -- Role
Booking -- StatutReservation
Payment -- StatutPaiement
@enduml
