@startuml deploiement
!include _style.iuml
title Diagramme de déploiement — Docker Compose

node "Navigateur\n(PC / mobile)" as BROWSER

node "Serveur (VPS Linux) — Docker" {
  node "web\nnginx:1.27\n:8080 → 80" as WEB {
    artifact "build React\n(dist/)" as DIST
  }
  node "backend\nphp:8.3-fpm\n:9000" as PHP {
    artifact "API Laravel" as LARAVEL
  }
  node "scheduler\nphp artisan schedule:work" as SCH
  node "mysql\nmysql:8.0" as MYSQL {
    database "teranga" as DB
  }
  node "mailpit (dev)\n:8025" as MAIL
  node "phpmyadmin (dev)\n:8081" as PMA
  storage "volume uploads\n(images)" as UP
  storage "volume mysql-data" as VDATA
}

cloud "Wave / Orange Money" as PSP

BROWSER --> WEB : HTTPS
WEB --> PHP : FastCGI /api
WEB ..> UP : /storage (lecture)
PHP ..> UP : écriture
PHP --> MYSQL : 3306
SCH --> MYSQL
PHP --> MAIL : SMTP 1025
PMA --> MYSQL
MYSQL ..> VDATA
PHP --> PSP : API paiement
PSP --> WEB : webhook /api/payments/webhook/wave
@enduml
