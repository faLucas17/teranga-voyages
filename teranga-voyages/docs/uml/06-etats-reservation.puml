@startuml etats-reservation
!include _style.iuml
title Diagramme d'états-transitions — réservation

[*] --> EnAttente : création\n(places bloquées)

state "En attente de paiement\n(pending)" as EnAttente
state "Confirmée\n(confirmed)" as Confirmee
state "Payée\n(paid)" as Payee
state "Annulée\n(cancelled)" as Annulee
state "Voyage effectué\n(completed)" as Effectue

EnAttente --> Payee : paiement total reçu
EnAttente --> Confirmee : agent confirme\n(paiement différé)
EnAttente --> Annulee : client annule /\nnon payée sous 48 h /\nagent annule
Confirmee --> Payee : solde réglé
Confirmee --> Annulee : annulation
Payee --> Effectue : après le voyage (agent)
Payee --> Annulee : annulation par l'agence\n(remboursement hors ligne)

Annulee --> [*] : places libérées,\ncode promo restitué
Effectue --> [*]
@enduml
