@startuml sequence-authentification
!include _style.iuml
title Diagramme de séquence — authentification (Laravel Sanctum)
autonumber

actor Utilisateur
participant "Frontend React\n(AuthContext)" as FE
participant "API /api/auth" as API
participant "Sanctum" as S
database "MySQL" as DB

Utilisateur -> FE : e-mail + mot de passe
FE -> API : POST /api/auth/login
API -> DB : SELECT user WHERE email
alt identifiants valides et compte actif
  API -> S : createToken("spa")
  S -> DB : INSERT personal_access_tokens
  API --> FE : { user, token }
  FE -> FE : localStorage.setItem(token)
  FE --> Utilisateur : redirection (espace client ou back-office selon le rôle)
else invalides
  API --> FE : 422 « Identifiants incorrects »
end

== Requêtes suivantes ==
FE -> API : GET /api/bookings\nAuthorization: Bearer <token>
API -> S : middleware auth:sanctum
S -> DB : vérifie le jeton (hash)
alt route /api/admin/*
  API -> API : middleware role:admin,agent
end
API --> FE : données

== Déconnexion ==
FE -> API : POST /api/auth/logout
API -> DB : DELETE token courant
FE -> FE : localStorage.removeItem(token)
@enduml
