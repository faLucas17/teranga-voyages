APP_NAME="Teranga Voyages"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Dakar
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=teranga
DB_USERNAME=teranga
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="reservations@teranga-voyages.sn"
MAIL_FROM_NAME="${APP_NAME}"

# --- Agence (marque blanche : changez ces valeurs pour revendre l'application) ---
AGENCY_NAME="Teranga Voyages"
AGENCY_EMAIL="contact@teranga-voyages.sn"
AGENCY_PHONE="+221 33 800 00 00"
AGENCY_CURRENCY=XOF
BOOKING_PREFIX=TV

# --- Paiement : simulation | wave | orange_money | stripe ---
PAYMENT_DEFAULT_DRIVER=simulation
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
