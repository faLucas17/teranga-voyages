@startuml sequence-reservation
!include _style.iuml
title Diagramme de séquence — réserver et payer un voyage
autonumber

actor Client
participant "Frontend React" as FE
participant "API Laravel\nBookingController" as API
participant "BookingService" as BS
participant "PaymentManager" as PM
participant "Passerelle\n(Wave / simulation)" as GW
database "MySQL" as DB

Client -> FE : Choisit un voyage, nb de voyageurs
FE -> API : POST /api/bookings/quote
API -> BS : quote(type, offre, données)
BS -> DB : lire offre, places, code promo
BS --> API : lignes, sous-total, remise, total
API --> FE : devis
FE --> Client : affiche le total en temps réel

Client -> FE : Saisit voyageurs et confirme
FE -> API : POST /api/bookings (jeton Bearer)
API -> API : validation des données
API -> BS : create(user, données)
activate BS
BS -> DB : BEGIN + SELECT ... FOR UPDATE (offre)
alt places suffisantes
  BS -> DB : INSERT booking (pending) + travelers
  BS -> DB : décrémente seats_available, used_count++
  BS -> DB : COMMIT
  BS ->> Client : e-mail « réservation enregistrée »
  BS --> API : réservation
  API --> FE : 201 Created
else complet
  BS -> DB : ROLLBACK
  BS --> API : erreur de validation
  API --> FE : 422 « Il ne reste que N places »
end
deactivate BS

Client -> FE : Clique « Payer » et choisit Wave
FE -> API : POST /api/bookings/{id}/pay
API -> PM : pay(booking, "wave")
PM -> DB : INSERT payment (pending)
PM -> GW : initiate(payment)
alt mode simulation
  GW -> PM : markSucceeded(payment)
  PM -> DB : payment = succeeded, booking = paid
  PM ->> Client : e-mail « paiement reçu »
  API --> FE : paiement réussi
else Wave réel
  GW --> API : checkout_url
  API --> FE : checkout_url
  FE -> Client : redirection vers Wave
  GW -> API : POST /api/payments/webhook/wave
  API -> PM : markSucceeded(payment)
  PM -> DB : payment = succeeded, booking = paid
end
@enduml
